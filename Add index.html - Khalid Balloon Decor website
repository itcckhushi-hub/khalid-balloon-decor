<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="description" content="Khalid Balloon Decor — balloon &amp; acrylic backdrop decoration studio in Pehowa, Haryana. Birthdays, anniversaries, proposals, weddings and more.">
<title>Khalid Balloon Decor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0E0918;
    --mesh-1:#FF3E8E; --mesh-2:#8B5CF6; --mesh-3:#FFB648; --mesh-4:#2FE0C0;
    --ink:#F6F1FB; --ink-soft:#BCAECC; --ink-faint:#8C7EA6;
    --glass:rgba(255,255,255,.055); --glass-strong:rgba(255,255,255,.10);
    --glass-border:rgba(255,255,255,.14); --glass-border-strong:rgba(255,255,255,.28);
    --magenta:#FF3E8E; --violet:#9370FF; --amber:#FFB648; --teal:#2FE0C0; --rose:#F2A0AC;
    --shadow-lg:0 34px 70px -26px rgba(0,0,0,.6);
    --shadow-md:0 18px 40px -18px rgba(0,0,0,.55);
    --radius-lg:28px; --radius-md:20px; --radius-sm:13px;
    --font-display:'Bricolage Grotesque', ui-sans-serif, 'Segoe UI', sans-serif;
    --font-body:'Manrope', ui-sans-serif, 'Segoe UI', sans-serif;
  }

  *{box-sizing:border-box;}
  html,body{background:var(--bg);}
  body{
    color:var(--ink); font-family:var(--font-body); line-height:1.6;
    -webkit-font-smoothing:antialiased; overflow-x:hidden; position:relative;
  }
  @media (prefers-reduced-motion: reduce){
    *,*::before,*::after{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important;}
  }
  h1,h2,h3{font-family:var(--font-display); font-weight:700; text-wrap:balance; margin:0; letter-spacing:-.01em;}
  p{margin:0;}
  a{color:inherit;}
  button{font-family:inherit;}
  ::selection{background:var(--magenta); color:#fff;}
  svg{display:block;}

  /* ---------- Ambient mesh background ---------- */
  .mesh{ position:fixed; inset:0; z-index:-3; overflow:hidden; background:var(--bg); }
  .mesh::before, .mesh::after{
    content:""; position:absolute; inset:-20%;
    background:
      radial-gradient(38% 32% at 14% 18%, color-mix(in srgb, var(--mesh-1) 55%, transparent), transparent 60%),
      radial-gradient(34% 30% at 82% 12%, color-mix(in srgb, var(--mesh-2) 55%, transparent), transparent 60%),
      radial-gradient(36% 34% at 78% 78%, color-mix(in srgb, var(--mesh-3) 45%, transparent), transparent 60%),
      radial-gradient(32% 30% at 12% 82%, color-mix(in srgb, var(--mesh-4) 45%, transparent), transparent 60%);
    filter:blur(60px) saturate(120%);
    animation:meshDrift 26s ease-in-out infinite alternate;
    opacity:.55;
  }
  .mesh::after{ animation-duration:34s; animation-direction:alternate-reverse; opacity:.35; transform:scale(1.15) rotate(8deg); }
  @keyframes meshDrift{
    0%{transform:translate3d(0,0,0) rotate(0deg) scale(1);}
    100%{transform:translate3d(2%,-3%,0) rotate(6deg) scale(1.08);}
  }
  .grain-veil{position:fixed; inset:0; z-index:-2; background:linear-gradient(180deg, rgba(14,9,24,0) 0%, rgba(14,9,24,.35) 100%); pointer-events:none;}

  /* ---------- Ambient background particles ---------- */
  .particle-field{ position:fixed; inset:0; z-index:-1; overflow:hidden; pointer-events:none; }
  .particle{ position:absolute; border-radius:50%; filter:blur(1px); animation-name:particleDrift; animation-timing-function:ease-in-out; animation-iteration-count:infinite; }
  @keyframes particleDrift{
    0%{ transform:translate(0,0) scale(.7); opacity:0; }
    12%{ opacity:.55; }
    50%{ transform:translate(var(--dx,24px), var(--dy,-34px)) scale(1); opacity:.75; }
    88%{ opacity:.35; }
    100%{ transform:translate(0,0) scale(.7); opacity:0; }
  }

  /* ---------- Aesthetic hearts (used sparingly) ---------- */
  .heart{
    position:absolute; width:var(--s,16px); height:var(--s,16px); opacity:.6;
    filter:drop-shadow(0 8px 16px rgba(0,0,0,.35));
    animation:heartFloat var(--dur,9s) ease-in-out infinite; animation-delay:var(--delay,0s);
    pointer-events:none; z-index:2;
  }
  .heart::before, .heart::after{ content:""; position:absolute; top:0; width:52%; height:80%; border-radius:50px 50px 0 0; background:var(--hc, var(--rose)); }
  .heart::before{ left:50%; transform:rotate(-45deg); transform-origin:0 100%; }
  .heart::after{ left:0; transform:rotate(45deg); transform-origin:100% 100%; }
  @keyframes heartFloat{
    0%,100%{ transform:translateY(0) rotate(-8deg) scale(.92); opacity:.32; }
    50%{ transform:translateY(-20px) rotate(6deg) scale(1.05); opacity:.75; }
  }

  .wrap{max-width:1220px; margin:0 auto; padding-inline:22px;}
  .eyebrow{
    display:inline-flex; align-items:center; gap:9px; font-weight:800; font-size:.7rem;
    letter-spacing:.16em; text-transform:uppercase; color:var(--ink-soft);
  }
  .eyebrow::before{content:""; width:16px; height:1px; background:var(--magenta);}

  /* ---------- Glass primitives ---------- */
  .acrylic{
    position:relative; overflow:hidden;
    background:linear-gradient(160deg, var(--glass-strong), var(--glass));
    backdrop-filter:blur(22px) saturate(150%);
    -webkit-backdrop-filter:blur(22px) saturate(150%);
    border:1px solid var(--glass-border);
    box-shadow:var(--shadow-lg), inset 0 1px 0 rgba(255,255,255,.2);
    border-radius:var(--radius-lg);
  }
  .card-interactive{ transition:transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s ease, border-color .3s ease; }
  .card-interactive:hover{ transform:translateY(-7px); border-color:var(--glass-border-strong); box-shadow:0 44px 80px -30px rgba(0,0,0,.65), inset 0 1px 0 rgba(255,255,255,.24); }
  .tilt{ transition:transform .35s cubic-bezier(.2,.8,.2,1); will-change:transform; transform-style:preserve-3d; }

  /* ---------- Nav ---------- */
  .site-nav{ position:sticky; top:calc(14px + env(safe-area-inset-top,0px)); z-index:80; padding-inline:16px; }
  .nav-inner{
    max-width:1220px; margin:0 auto;
    display:flex; align-items:center; justify-content:space-between;
    padding:10px 10px 10px 20px; border-radius:999px;
  }
  .brand{ position:relative; display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-weight:700; font-size:1.05rem; text-decoration:none; }
  .brand-mark{ width:16px; height:20px; border-radius:50% 50% 50% 50%/58% 58% 42% 42%; background:radial-gradient(circle at 30% 28%, #fff9, var(--magenta) 72%); position:relative; flex:none; }
  .nav-links{ display:flex; align-items:center; gap:6px; list-style:none; margin:0; padding:0; }
  .nav-links a{ text-decoration:none; font-weight:700; font-size:.86rem; color:var(--ink-soft); padding:9px 14px; border-radius:999px; transition:color .2s, background .2s; }
  .nav-links a:hover{ color:var(--ink); background:var(--glass); }
  .nav-cta{
    display:inline-flex; align-items:center; gap:8px; background:linear-gradient(135deg, var(--magenta), var(--violet));
    color:#fff; font-weight:800; font-size:.82rem; padding:11px 18px; border-radius:999px; text-decoration:none;
    box-shadow:0 14px 28px -10px color-mix(in srgb, var(--magenta) 65%, transparent); transition:transform .2s ease;
  }
  .nav-cta:hover{ transform:translateY(-2px); }
  .nav-toggle{ display:none; background:none; border:none; color:var(--ink); cursor:pointer; padding:8px; }

  @media (max-width:860px){
    .nav-links{
      position:absolute; top:calc(100% + 10px); left:16px; right:16px; flex-direction:column; align-items:stretch; gap:4px;
      padding:14px; max-height:0; overflow:hidden; opacity:0; transition:max-height .3s ease, opacity .3s ease;
    }
    .nav-links.open{ max-height:400px; opacity:1; }
    .nav-links a{ padding:13px 16px; }
    .nav-toggle{ display:block; }
  }

  /* ---------- Buttons ---------- */
  .btn{
    display:inline-flex; align-items:center; gap:10px; font-weight:800; font-size:.92rem;
    padding:15px 26px; border-radius:999px; text-decoration:none; border:1px solid transparent;
    cursor:pointer; transition:transform .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .btn svg{ width:18px; height:18px; }
  .btn:hover{ transform:translateY(-3px); }
  .btn:active{ transform:translateY(-1px) scale(.98); }
  .btn-solid{ background:linear-gradient(135deg, var(--magenta), var(--violet)); color:#fff; box-shadow:0 18px 34px -14px color-mix(in srgb, var(--magenta) 70%, transparent); }
  .btn-glass{ background:var(--glass-strong); border-color:var(--glass-border-strong); color:var(--ink); backdrop-filter:blur(14px); }
  .btn-glass:hover{ border-color:var(--magenta); }
  .btn-dark{ background:#150F24; color:var(--ink); border-color:var(--glass-border); }

  /* ---------- Hero ---------- */
  .hero{ position:relative; padding-block:64px 60px; perspective:1400px; }
  .hero-inner{ display:grid; grid-template-columns:1.05fr .95fr; gap:48px; align-items:center; }
  .hero h1{ font-size:clamp(2.3rem, 4.6vw, 3.6rem); line-height:1.05; margin-block:18px; }
  .hero h1 .grad{ background:linear-gradient(120deg, var(--magenta), var(--amber) 55%, var(--violet)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .hero-sub{ max-width:48ch; color:var(--ink-soft); font-size:1.06rem; }
  .hero-ctas{ display:flex; flex-wrap:wrap; gap:14px; margin-top:30px; }

  .trust-row{ display:flex; flex-wrap:wrap; gap:10px; margin-top:34px; }
  .trust-pill{
    display:inline-flex; align-items:center; gap:8px; font-size:.78rem; font-weight:700; color:var(--ink-soft);
    padding:9px 15px; border-radius:999px; background:var(--glass); border:1px solid var(--glass-border);
  }
  .trust-pill svg{ width:14px; height:14px; color:var(--amber); }

  /* ---------- Hero acrylic stage (ambient 3D motion) ---------- */
  .hero-stage{ position:relative; height:440px; perspective:1200px; }
  .hero-panel{ position:absolute; inset:6% 4%; border-radius:32px; overflow:visible; }
  .hero-panel-inner{ position:absolute; inset:0; overflow:hidden; border-radius:32px; }

  .db-wrap{
    position:absolute; transform-style:preserve-3d;
    animation-name:floatBalloon; animation-timing-function:ease-in-out; animation-iteration-count:infinite;
    animation-duration:var(--dur,7s); animation-delay:var(--delay,0s);
  }
  @keyframes floatBalloon{
    0%,100%{ transform:translate3d(0,0,0) rotate(-4deg); }
    50%{ transform:translate3d(6px,-20px,18px) rotate(4deg); }
  }
  .depth-balloon{
    position:relative; display:block; border-radius:50% 50% 50% 50% / 58% 58% 42% 42%;
    box-shadow:inset -12px -16px 22px -6px rgba(0,0,0,.4), 0 20px 40px -16px rgba(0,0,0,.5);
    transition:transform .35s ease;
  }
  .depth-balloon::after{ content:""; position:absolute; left:50%; top:100%; width:1.5px; height:70px; background:linear-gradient(rgba(255,255,255,.3), transparent); }
  .dbp1{ left:8%; top:10%; --dur:6.6s; --delay:0s; }
  .dbp2{ left:52%; top:2%; --dur:7.4s; --delay:-1.6s; }
  .dbp3{ left:30%; top:44%; --dur:5.9s; --delay:-2.8s; }
  .dbp4{ left:66%; top:52%; --dur:8.2s; --delay:-3.6s; }
  .dbp5{ left:4%; top:64%; --dur:7s; --delay:-1.1s; }
  .db1{ width:120px; height:150px; background:radial-gradient(circle at 30% 26%, #fff8, var(--magenta) 72%); opacity:.95; }
  .db2{ width:80px; height:100px; background:radial-gradient(circle at 30% 26%, #fff8, var(--violet) 72%); opacity:.9; }
  .db3{ width:96px; height:120px; background:radial-gradient(circle at 30% 26%, #fff8, var(--amber) 72%); }
  .db4{ width:60px; height:76px; background:radial-gradient(circle at 30% 26%, #fff8, var(--teal) 72%); opacity:.85; }
  .db5{ width:44px; height:56px; background:radial-gradient(circle at 30% 26%, #fff8, var(--rose) 72%); opacity:.7; }

  .hero-badge{
    position:absolute; right:-14px; bottom:-18px; z-index:4; display:flex; align-items:center; gap:10px;
    padding:14px 18px; border-radius:20px;
  }
  .hero-badge strong{ display:block; font-family:var(--font-display); font-size:1.05rem; }
  .hero-badge span{ display:block; font-size:.72rem; color:var(--ink-soft); font-weight:700; }

  @media (max-width:940px){
    .hero-inner{ grid-template-columns:1fr; }
    .hero-stage{ height:300px; order:-1; }
    .hero-badge{ right:8px; bottom:-14px; }
  }

  /* ---------- Section shell ---------- */
  section{ padding-block:88px; position:relative; }
  .section-head{ max-width:640px; margin-bottom:44px; }
  .section-head h2{ font-size:clamp(1.7rem, 3.2vw, 2.3rem); margin-top:10px; }
  .section-head p{ color:var(--ink-soft); margin-top:12px; font-size:1.02rem; }

  /* ---------- About ---------- */
  .about-grid{ display:grid; grid-template-columns:1fr 1fr; gap:52px; align-items:center; }
  .about-copy p + p{ margin-top:14px; }
  .about-copy p{ color:var(--ink-soft); }
  .feature-list{ list-style:none; margin:28px 0 0; padding:0; display:grid; gap:14px; }
  .feature-list li{ display:flex; align-items:center; gap:14px; font-weight:700; font-size:.94rem; }
  .feature-dot{ width:38px; height:38px; border-radius:12px; display:flex; align-items:center; justify-content:center; flex:none; background:var(--glass); border:1px solid var(--glass-border); color:var(--amber); }
  .feature-dot svg{ width:17px; height:17px; }

  .about-visual{ position:relative; }
  .orbit-ring{ position:absolute; inset:-28px; border:1px dashed var(--glass-border-strong); border-radius:38px; opacity:.35; animation:spin 55s linear infinite; pointer-events:none; }
  .orbit-ring-2{ inset:-52px; border-radius:46px; opacity:.2; animation-duration:80s; animation-direction:reverse; }
  @keyframes spin{ to{ transform:rotate(360deg); } }

  .about-card{ position:relative; padding:36px; z-index:1; }
  .about-card h3{ font-size:1.25rem; margin-bottom:6px; }
  .about-card .loc{ display:flex; align-items:center; gap:10px; color:var(--ink-soft); font-weight:600; font-size:.88rem; margin-top:10px; }
  .about-card .loc svg{ width:16px; height:16px; color:var(--amber); flex:none; }
  .mini-garland{ display:flex; gap:9px; margin-top:24px; }
  .mini-b{ width:18px; height:23px; border-radius:50% 50% 50% 50%/58% 58% 42% 42%; }

  /* ---------- Catalog / filter ---------- */
  .filter-row{ display:flex; flex-wrap:wrap; gap:10px; margin-bottom:34px; }
  .filter-chip{
    font-size:.82rem; font-weight:700; padding:10px 18px; border-radius:999px; cursor:pointer;
    background:var(--glass); border:1px solid var(--glass-border); color:var(--ink-soft);
    transition:background .2s ease, color .2s ease, border-color .2s ease;
  }
  .filter-chip:hover{ color:var(--ink); }
  .filter-chip.active{ background:linear-gradient(135deg, var(--magenta), var(--violet)); color:#fff; border-color:transparent; }

  .catalog-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:22px; }
  .catalog-card{ padding:0; display:flex; flex-direction:column; }
  .catalog-card[hidden]{ display:none; }
  .catalog-visual{ position:relative; height:180px; overflow:hidden; border-radius:var(--radius-lg) var(--radius-lg) 0 0; }
  .catalog-visual .glow{ position:absolute; inset:-30%; filter:blur(30px); opacity:.55; }
  .catalog-body{ padding:22px 22px 24px; position:relative; }
  .cat-tag{ display:inline-block; font-size:.68rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; padding:5px 11px; border-radius:999px; color:#fff; margin-bottom:12px; }
  .catalog-card h3{ font-size:1.08rem; margin-bottom:8px; }
  .catalog-card p{ color:var(--ink-soft); font-size:.89rem; }
  .catalog-link{ display:inline-flex; align-items:center; gap:6px; margin-top:16px; font-weight:800; font-size:.85rem; color:var(--ink); text-decoration:none; }
  .catalog-link svg{ width:14px; height:14px; transition:transform .2s ease; }
  .catalog-link:hover svg{ transform:translate(2px,-2px); }

  @media (max-width:920px){ .catalog-grid{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:600px){ .catalog-grid{ grid-template-columns:1fr; } }

  /* ---------- Gallery ---------- */
  .gallery-note{ font-size:.86rem; color:var(--ink-faint); margin-top:-8px; margin-bottom:32px; }
  .gallery-grid{ display:grid; grid-template-columns:repeat(4, 1fr); gap:18px; }
  .gallery-card{ aspect-ratio:3/4; position:relative; display:flex; align-items:flex-end; padding:18px; }
  .gallery-card .glow{ position:absolute; inset:-40%; filter:blur(36px); opacity:.5; }
  .gallery-card span:not(.glow){ position:relative; z-index:2; font-weight:800; font-size:.94rem; }
  @media (max-width:900px){ .gallery-grid{ grid-template-columns:repeat(2,1fr); } }

  /* ---------- Socials ---------- */
  .social-strip{ display:flex; flex-wrap:wrap; gap:16px; }
  .social-card{ flex:1 1 210px; display:flex; align-items:center; gap:14px; padding:20px; text-decoration:none; color:var(--ink); }
  .social-ic{ width:44px; height:44px; border-radius:14px; flex:none; display:flex; align-items:center; justify-content:center; background:var(--glass-strong); border:1px solid var(--glass-border); color:var(--amber); }
  .social-ic svg{ width:20px; height:20px; }
  .social-card strong{ display:block; font-size:.96rem; }
  .social-card small{ color:var(--ink-soft); font-weight:600; }

  /* ---------- Contact ---------- */
  .contact-grid{ display:grid; grid-template-columns:1.1fr .9fr; gap:36px; }
  .contact-panel{ padding:44px; position:relative; }
  .contact-panel h3{ font-size:1.55rem; margin-bottom:12px; }
  .contact-panel p{ color:var(--ink-soft); max-width:42ch; }
  .contact-panel .btn{ margin-top:28px; }
  .info-card{ padding:32px; }
  .info-list{ list-style:none; margin:0; padding:0; display:grid; gap:22px; }
  .info-list li{ display:flex; gap:16px; }
  .info-ic{ width:42px; height:42px; border-radius:13px; background:var(--glass-strong); border:1px solid var(--glass-border); display:flex; align-items:center; justify-content:center; flex:none; color:var(--amber); }
  .info-ic svg{ width:18px; height:18px; }
  .info-list strong{ display:block; font-size:.96rem; margin-bottom:2px; }
  .info-list span{ color:var(--ink-soft); font-size:.9rem; }
  @media (max-width:860px){ .contact-grid{ grid-template-columns:1fr; } }

  /* ---------- Footer ---------- */
  footer{ border-top:1px solid var(--glass-border); padding-block:36px; text-align:center; color:var(--ink-faint); font-size:.84rem; }
  footer .brand{ justify-content:center; margin-bottom:12px; }

  /* ---------- Floating book button ---------- */
  .fab{
    position:fixed; right:22px; bottom:calc(22px + env(safe-area-inset-bottom,0px)); z-index:90;
    width:60px; height:60px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg, var(--magenta), var(--violet)); color:#fff; text-decoration:none;
    box-shadow:0 20px 36px -12px color-mix(in srgb, var(--magenta) 70%, transparent); border:none; cursor:pointer;
    transition:transform .2s ease;
  }
  .fab svg{ width:24px; height:24px; }
  .fab:hover{ transform:scale(1.08); }

  .confetti-piece{ position:fixed; z-index:999; pointer-events:none; top:0; left:0; will-change:transform, opacity; }
</style>
</head>
<body>


<div class="mesh"></div>
<div class="grain-veil"></div>
<div class="particle-field" id="particleField"></div>

<nav class="site-nav">
  <div class="nav-inner acrylic">
    <a href="#top" class="brand">
      <span class="brand-mark"></span>
      Khalid Balloon Decor
    </a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
    </button>
    <ul class="nav-links" id="navLinks">
      <li><a href="#about">About</a></li>
      <li><a href="#looks">Signature Looks</a></li>
      <li><a href="#gallery">Gallery</a></li>
      <li><a href="#follow">Follow</a></li>
      <li><a href="#contact">Contact</a></li>
      <li><a href="#" id="navWhatsapp" class="nav-cta confetti-trigger">Book on WhatsApp</a></li>
    </ul>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap hero-inner">
    <div>
      <span class="eyebrow">Pehowa · Balloon &amp; Acrylic Decor Studio</span>
      <h1>Décor that feels <span class="grad">designed</span>, not decorated.</h1>
      <p class="hero-sub">Khalid Balloon Decor builds balloon installations and acrylic backdrops for birthdays, anniversaries, proposals and weddings across Pehowa &amp; Kurukshetra — styled around your space, not a catalogue photo.</p>
      <div class="hero-ctas">
        <a href="#" id="whatsappHero" class="btn btn-solid confetti-trigger">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.9 7.3L3 20l1.2-5A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.5 10.5c0 3 2 5 5 5"/></svg>
          Chat on WhatsApp
        </a>
        <a href="#looks" class="btn btn-glass">
          View signature looks
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
