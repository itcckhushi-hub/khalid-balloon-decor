<script>
(function(){
  var PHONE_NUMBER = "918950402633";
  var waMessage = encodeURIComponent("Hi Khalid Balloon Decor! I'd like to enquire about balloon decoration.");
  var waLink = "https://wa.me/" + PHONE_NUMBER + "?text=" + waMessage;
  var telLink = "tel:+" + PHONE_NUMBER;
  ["whatsappHero","whatsappContact","fabWhatsapp","navWhatsapp"].forEach(function(id){
    var el = document.getElementById(id);
    if(el){ el.href = waLink; el.target = "_blank"; el.rel = "noopener"; }
  });
  var call = document.getElementById("callBtn");
  if(call){ call.href = telLink; }

  document.getElementById("year").textContent = new Date().getFullYear();

  /* ---- mobile nav ---- */
  var toggle = document.getElementById("navToggle");
  var links = document.getElementById("navLinks");
  toggle.addEventListener("click", function(){
    var open = links.classList.toggle("open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
  links.querySelectorAll("a").forEach(function(a){
    a.addEventListener("click", function(){ links.classList.remove("open"); });
  });

  /* ---- ambient background particles ---- */
  var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var particleColors = ["#FF3E8E","#9370FF","#FFB648","#2FE0C0","#F2A0AC"];
  var field = document.getElementById("particleField");
  if(field && !reduceMotion){
    var n = 14;
    for(var i=0;i<n;i++){
      var p = document.createElement("span");
      p.className = "particle";
      var size = 3 + Math.random()*6;
      var color = particleColors[Math.floor(Math.random()*particleColors.length)];
      p.style.left = (Math.random()*100) + "%";
      p.style.top = (Math.random()*100) + "%";
      p.style.width = size + "px";
      p.style.height = size + "px";
      p.style.background = color;
      p.style.setProperty("--dx", ((Math.random()-0.5)*60) + "px");
      p.style.setProperty("--dy", (-(30 + Math.random()*70)) + "px");
      p.style.animationDuration = (14 + Math.random()*16) + "s";
      p.style.animationDelay = (-Math.random()*20) + "s";
      field.appendChild(p);
    }
  }

  /* ---- catalog data + render ---- */
  var CATALOG = [
    { cat:"birthday", label:"Birthday", color:"var(--magenta)", title:"Cloud Nine Birthday Backdrop", desc:"Layered balloon clouds around an acrylic name panel — built for the cake-cutting shot." },
    { cat:"birthday", label:"Birthday", color:"var(--magenta)", title:"Number Spiral Setup", desc:"Oversized balloon-wrapped number with a colour-matched garland arch." },
    { cat:"anniversary", label:"Anniversary", color:"var(--rose)", title:"Rose Gold Anniversary Wall", desc:"Warm-tone balloon wall with an acrylic monogram and soft ambient lighting." },
    { cat:"proposal", label:"Proposal", color:"var(--violet)", title:"Midnight Proposal Scene", desc:"Candle-lit balloon arch with an acrylic 'Marry Me' panel, styled for photos." },
    { cat:"wedding", label:"Wedding", color:"var(--amber)", title:"Grand Entrance Arch", desc:"Full-scale balloon &amp; floral entrance arch for baraat or stage entry." },
    { cat:"wedding", label:"Wedding", color:"var(--amber)", title:"Mandap Balloon Accent", desc:"Balloon clusters woven through a traditional mandap structure." },
    { cat:"welcome", label:"Welcome Home", color:"var(--teal)", title:"Home &amp; Baby Welcome Door", desc:"Doorway balloon frame with an acrylic 'Welcome Home' backdrop panel." },
    { cat:"festive", label:"Festive", color:"var(--violet)", title:"Custom Festive Corner", desc:"Tell us the festival or theme — palette and layout built around it." }
  ];

  var grid = document.getElementById("catalogGrid");
  CATALOG.forEach(function(item){
    var card = document.createElement("div");
    card.className = "catalog-card acrylic card-interactive";
    card.dataset.cat = item.cat;
    card.innerHTML =
      '<div class="catalog-visual">' +
        '<span class="glow" style="background:radial-gradient(circle, ' + item.color + ', transparent 70%);"></span>' +
      '</div>' +
      '<div class="catalog-body">' +
        '<span class="cat-tag" style="background:' + item.color + ';">' + item.label + '</span>' +
        '<h3>' + item.title + '</h3>' +
        '<p>' + item.desc + '</p>' +
        '<a href="' + waLink + '&text=' + encodeURIComponent("Hi! I'm interested in the \"" + item.title + "\" look.") + '" target="_blank" rel="noopener" class="catalog-link confetti-trigger">Enquire on WhatsApp <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg></a>' +
      '</div>';
    grid.appendChild(card);
  });

  /* ---- filter ---- */
  document.getElementById("filterRow").addEventListener("click", function(e){
    var chip = e.target.closest(".filter-chip");
    if(!chip) return;
    document.querySelectorAll(".filter-chip").forEach(function(c){ c.classList.remove("active"); });
    chip.classList.add("active");
    var f = chip.dataset.filter;
    grid.querySelectorAll(".catalog-card").forEach(function(card){
      card.hidden = !(f === "all" || card.dataset.cat === f);
    });
  });

  /* ---- 3D tilt (pointer-fine devices only) ---- */
  var canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  function applyTilt(el, max){
    el.addEventListener("pointermove", function(e){
      var r = el.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width;
      var py = (e.clientY - r.top) / r.height;
      var rx = (py - 0.5) * -max;
      var ry = (px - 0.5) * max;
      el.style.transform = "perspective(1000px) rotateX(" + rx + "deg) rotateY(" + ry + "deg) translateZ(0)";
    });
    el.addEventListener("pointerleave", function(){ el.style.transform = ""; });
  }
  if(canHover && !reduceMotion){
    applyTilt(document.getElementById("heroPanel"), 9);
    document.querySelectorAll(".catalog-card").forEach(function(c){ applyTilt(c, 6); });

    var stage = document.getElementById("heroStage");
    stage.addEventListener("pointermove", function(e){
      var r = stage.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      stage.querySelectorAll(".depth-balloon").forEach(function(b, i){
        var depth = (i + 1) * 4;
        b.style.transform = "translate(" + (px * depth) + "px," + (py * depth) + "px)";
      });
    });
    stage.addEventListener("pointerleave", function(){
      stage.querySelectorAll(".depth-balloon").forEach(function(b){ b.style.transform = ""; });
    });
  }

  /* ---- confetti / balloon burst (primary CTAs only) ---- */
  var colors = ["#FF3E8E","#9370FF","#FFB648","#2FE0C0","#F2A0AC"];
  function spawnBurst(x, y){
    if(reduceMotion) return;
    var count = 9;
    for(var i=0;i<count;i++){
      var piece = document.createElement("span");
      piece.className = "confetti-piece";
      var isBalloon = Math.random() > 0.5;
      var color = colors[Math.floor(Math.random()*colors.length)];
      var size = isBalloon ? (9 + Math.random()*8) : (5 + Math.random()*4);
      if(isBalloon){
        piece.style.width = size + "px";
        piece.style.height = (size*1.25) + "px";
        piece.style.background = "radial-gradient(circle at 30% 28%, #fff9, " + color + " 72%)";
        piece.style.borderRadius = "50% 50% 50% 50% / 58% 58% 42% 42%";
      } else {
        piece.style.width = size + "px";
        piece.style.height = size + "px";
        piece.style.background = color;
        piece.style.borderRadius = Math.random() > .5 ? "50%" : "3px";
      }
      var dx = (Math.random()-0.5) * 200;
      var dy = -(110 + Math.random()*150);
      var rot = (Math.random()-0.5) * 420;
      var dur = 700 + Math.random()*450;
      piece.style.left = x + "px";
      piece.style.top = y + "px";
      piece.style.opacity = "1";
      piece.style.transition = "transform " + dur + "ms cubic-bezier(.2,.7,.3,1), opacity " + dur + "ms ease";
      document.body.appendChild(piece);
      requestAnimationFrame((function(p, dx, dy, rot){
        return function(){
          p.style.transform = "translate(" + dx + "px," + dy + "px) rotate(" + rot + "deg)";
          p.style.opacity = "0";
        };
      })(piece, dx, dy, rot));
      (function(p, dur){ setTimeout(function(){ p.remove(); }, dur + 60); })(piece, dur);
    }
  }
  document.addEventListener("click", function(e){
    var trigger = e.target.closest(".confetti-trigger");
    if(!trigger) return;
    spawnBurst(e.clientX, e.clientY);
  });
})();
</script>

